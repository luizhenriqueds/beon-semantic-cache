GEMINI_API_KEY=

# none | exact | semantic
CACHE_STRATEGY=semantic

# pgvector (local docker) or upstash (remote)
CACHE_BACKEND=pgvector
SIMILARITY_THRESHOLD=0.9

# Postgres: local docker default, or your Supabase connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/semcache

# Only needed when CACHE_BACKEND=upstash
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
