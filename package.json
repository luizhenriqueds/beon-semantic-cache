{
  "name": "semantic-cache-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "data:answers": "tsx --env-file-if-exists=.env scripts/generate-answers.ts",
    "data:load": "tsx --env-file-if-exists=.env scripts/load-data.ts",
    "cache:seed": "tsx --env-file-if-exists=.env scripts/seed-cache.ts",
    "test": "vitest run",
    "bench": "tsx --env-file-if-exists=.env bench/run.ts",
    "bench:report": "tsx bench/report.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@upstash/vector": "^1.2.3",
    "csv-parse": "^7.0.3",
    "next": "^16.4.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
